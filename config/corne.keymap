#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &kp RET   &mo 1   &mo 2 &kp SPACE &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp ESC &none    &kp N1  &kp N2  &kp N3 &none      &none    &none     &none   &none	   &none  &kp DEL
   &trans  &none    &kp N4  &kp N5  &kp N6 &kp N0     &kp LEFT &kp DOWN  &kp UP  &kp RIGHT &none  &trans
   &trans  &kp DOT  &kp N7  &kp N8  &kp N9 &none      &none    &none     &none   &none     &none  &trans
                            &trans  &trans &trans     &trans   &trans    &trans  
                        >;
                };
                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp ESC   &none  &kp EXCL &kp AT    &kp HASH   &none      &none     &none     &kp LPAR  &kp RPAR &none    &kp DEL
   &kp LCTRL &none  &kp DLLR &kp PRCNT &kp CARET  &none      &kp MINUS &kp EQUAL &kp LBRC  &kp RBRC &kp NUHS &kp GRAVE
   &kp LSHFT &none  &kp AMPS &kp ASTRK &none      &none      &kp UNDER &kp PLUS  &kp LBKT  &kp RBKT &kp NUBS &kp TILDE
                             &trans    &trans     &trans     &trans    &trans    &trans
                        >;
                };
        };
};
